{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redshieldworks.dev/schemas/core/agent-capability-grant.schema.json",
  "title": "RedshieldWorks Core Agent Capability Grant",
  "description": "Delegated, sender-constrained grant allowing an agent or service workload to create or populate a RedshieldWorks secure intake within explicit scope limits.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "grant_id",
    "grant_profile",
    "issuer",
    "issued_at",
    "expires_at",
    "audience",
    "workload",
    "delegation",
    "scope",
    "allowed_actions",
    "limits",
    "sender_constraint",
    "revocation_status_ref",
    "audit_correlation"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "grant_id": {
      "type": "string",
      "pattern": "^agent-capability-grant-[a-z0-9][a-z0-9-]{6,}$"
    },
    "grant_profile": {
      "const": "redshieldworks-agent-capability-grant.v0"
    },
    "issuer": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "not_before": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "audience": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,}$"
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workload_id", "workload_issuer"],
      "properties": {
        "workload_id": {
          "type": "string",
          "minLength": 1
        },
        "workload_issuer": {
          "type": "string",
          "minLength": 1
        },
        "actor_id": {
          "type": "string",
          "pattern": "^actor-[a-z0-9][a-z0-9-]{6,}$"
        }
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delegation_id", "source_type", "purpose"],
      "properties": {
        "delegation_id": {
          "type": "string",
          "pattern": "^delegation-[a-z0-9][a-z0-9-]{6,}$"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "human_user",
            "workflow",
            "service_account",
            "policy_decision"
          ]
        },
        "authorizing_actor_id": {
          "type": "string",
          "pattern": "^actor-[a-z0-9][a-z0-9-]{6,}$"
        },
        "authorizing_workflow_id": {
          "type": "string",
          "pattern": "^workflow-[a-z0-9][a-z0-9-]{6,}$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id"],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "secure_intake_session_id": {
          "type": "string",
          "pattern": "^secure-intake-[a-z0-9][a-z0-9-]{6,}$"
        },
        "account_id": {
          "type": "string",
          "minLength": 1
        },
        "channel_id": {
          "type": "string",
          "pattern": "^[0-9]{10,}$"
        }
      }
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/agent_secure_intake_action"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_classes",
        "max_sensitivity",
        "content_access",
        "ai_processing"
      ],
      "properties": {
        "source_classes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_class"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "max_sensitivity": {
          "$ref": "#/$defs/sensitivity"
        },
        "content_access": {
          "type": "string",
          "enum": ["metadata_only", "redacted_content", "raw_content_reference"]
        },
        "ai_processing": {
          "type": "string",
          "enum": [
            "not_allowed",
            "requires_manifest_approval",
            "may_start_after_policy_allow"
          ]
        },
        "max_source_items": {
          "type": "integer",
          "minimum": 1
        },
        "allowed_operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ai_capability"
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "policy_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status"],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "provider": {
          "type": "string",
          "enum": ["rsk-security-knightwarden", "product-local-policy"]
        },
        "status": {
          "type": "string",
          "enum": [
            "not_required",
            "required_before_ingestion",
            "allowed",
            "denied",
            "unavailable"
          ]
        },
        "policy_decision_id": {
          "type": "string",
          "pattern": "^policy-decision-[a-z0-9][a-z0-9-]{6,}$"
        }
      }
    },
    "sender_constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sender_constraint_id", "method"],
      "properties": {
        "sender_constraint_id": {
          "type": "string",
          "pattern": "^sender-[a-z0-9][a-z0-9-]{6,}$"
        },
        "method": {
          "type": "string",
          "enum": ["hmac-sha256-test", "jws-dpop", "mtls", "spiffe"]
        }
      }
    },
    "revocation_status_ref": {
      "type": "string",
      "pattern": "^grant-status-[a-z0-9][a-z0-9-]{6,}$"
    },
    "audit_correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correlation_id"],
      "properties": {
        "correlation_id": {
          "type": "string",
          "pattern": "^audit-correlation-[a-z0-9][a-z0-9-]{6,}$"
        },
        "request_context_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{32,128}$"
        },
        "attestation_result_id": {
          "type": "string",
          "pattern": "^attestation-[a-z0-9][a-z0-9-]{6,}$"
        }
      }
    }
  },
  "$defs": {
    "agent_secure_intake_action": {
      "type": "string",
      "enum": [
        "create_secure_intake",
        "register_intake_source",
        "upload_intake_material",
        "finalize_agent_populated_intake"
      ]
    },
    "source_class": {
      "type": "string",
      "enum": [
        "email_item",
        "cloud_drive_file",
        "local_file",
        "discord_export",
        "accounting_export",
        "banking_export",
        "payroll_export",
        "document_record",
        "manual_upload",
        "other"
      ]
    },
    "sensitivity": {
      "type": "string",
      "enum": ["public", "internal", "confidential", "restricted", "secret"]
    },
    "ai_capability": {
      "type": "string",
      "enum": [
        "extract_facts",
        "classify",
        "summarize",
        "build_timeline",
        "generate_diagnostics",
        "ask_questions",
        "draft_text",
        "propose_actions",
        "suggest_evidence_links"
      ]
    }
  }
}

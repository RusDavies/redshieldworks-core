{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redshieldworks.dev/schemas/core/work-item.schema.json",
  "title": "RedshieldWorks Core Work Item",
  "description": "Reviewable proposed, approved, rejected, or queued action emitted by a RedshieldWorks module.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_item_id",
    "source_module",
    "work_item_type",
    "priority",
    "summary",
    "status",
    "approval",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "work_item_id": {
      "type": "string",
      "pattern": "^(work-item|notice-action)-[a-z0-9][a-z0-9-]{6,}$"
    },
    "source_module": {
      "type": "string",
      "pattern": "^redshieldworks-[a-z0-9][a-z0-9-]*$"
    },
    "work_item_type": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_\\-]*$"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "waiting_for_approval",
        "approved",
        "rejected",
        "queued",
        "in_progress",
        "implemented_internal_work_item",
        "blocked",
        "cancelled",
        "done"
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "status",
        "gate"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "not_required",
            "proposed",
            "approved",
            "rejected",
            "expired"
          ]
        },
        "gate": {
          "type": "string",
          "enum": [
            "not_required",
            "external_action",
            "financial_action",
            "tax_action",
            "legal_action",
            "privacy_sensitive_action",
            "destructive_action",
            "production_change",
            "public_release"
          ]
        },
        "approved_by": {
          "type": "string"
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "due_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "evidence-reference.schema.json"
      },
      "default": []
    },
    "context": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": [
              "string",
              "number",
              "integer",
              "boolean",
              "null"
            ]
          },
          {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number",
                "integer",
                "boolean",
                "null"
              ]
            }
          }
        ]
      },
      "default": {}
    },
    "workflow_context": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional structured context for workflow-backed work items. Complex payloads still belong in referenced artifacts, not inline here.",
      "properties": {
        "workflow_id": {
          "type": "string"
        },
        "workflow_type": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_\\-]*$"
        },
        "domain": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "document_id": {
          "type": "string"
        },
        "document_version_id": {
          "type": "string"
        },
        "signature_packet_id": {
          "type": "string"
        },
        "policy_check_id": {
          "type": "string",
          "pattern": "^policy-check-[a-z0-9][a-z0-9-]{6,}$"
        },
        "permission": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*$"
        },
        "requires_reason": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "related_record_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "not_started",
            "waiting_for_approval",
            "queued",
            "implemented_internal_work_item",
            "external_action_required",
            "rejected_no_action",
            "failed"
          ]
        },
        "result_summary": {
          "type": "string"
        },
        "output_refs": {
          "type": "array",
          "items": {
            "$ref": "evidence-reference.schema.json"
          },
          "default": []
        }
      }
    }
  }
}
